{
    "name": "@hartejsingh/angelos",
    "version": "1.0.0",
    "description": "Frictionless WhatsApp QR-based phone verification engine for Node.js",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run typecheck && npm run build"
    },
    "dependencies": {
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/qrcode": "^1.5.5",
        "tsup": "^8.3.0",
        "typescript": "^5.5.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "author": "Hartejsingh Sandhu",
    "license": "MIT"
}
