{
    "name": "angelos",
    "version": "1.0.3",
    "description": "Frictionless WhatsApp QR-based phone verification engine for Node.js",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hartej46/angelos.git"
    },
    "homepage": "https://github.com/hartej46/angelos#readme",
    "bugs": {
        "url": "https://github.com/hartej46/angelos/issues"
    },
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run typecheck && npm run build"
    },
    "dependencies": {
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/qrcode": "^1.5.5",
        "tsup": "^8.3.0",
        "typescript": "^5.5.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "author": "Hartejsingh Sandhu",
    "keywords": [
        "whatsapp",
        "whatsapp-auth",
        "whatsapp-otp",
        "otp-verification",
        "phone-verification",
        "authentication",
        "auth",
        "qr-code-login",
        "deep-link",
        "meta-cloud-api",
        "webhook",
        "zero-cost-otp",
        "inbound-sms-alternative",
        "typescript"
    ],
    "license": "MIT"
}
